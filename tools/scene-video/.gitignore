node_modules/
vendor/

# 회차 산출물 — 대본(scene.json)과 그림(kinds/)만 있으면 결정성으로 그대로 다시 나온다.
# 리포에 담는 것은 '만드는 데 필요한 것'이지 '만들어진 것'이 아니다.
episodes/*/build/audio/
episodes/*/build/stills/
episodes/*/build/*.mp4
episodes/*/build/track.wav
episodes/*/build/upload.txt
episodes/*/build/youtube.json

# 목소리 클로닝용 생녹음 — 리포가 PUBLIC 이다. 원본이 올라가면 누구나 같은 방법으로 복제한다.
voices/

# 🔴 클로닝한 목소리 임베딩(ME.json) — 2026-08-02 사용자 지시로 추적 해제.
# 처음엔 "녹음 원본이 비공개라 리포만 보고는 재현할 수 없으니 이건 커밋한다"로 정했는데
# (VOICE_CLONE.md 5절), 그 판단은 **생녹음만 위험하다**고 본 것이었다. 임베딩도 본인 음색이고
# 리포가 PUBLIC 이라 결론이 뒤집혔다 — 이걸로 임의의 문장을 합성할 수 있다.
# ⚠️ 그래서 git 이 더는 이 파일의 백업이 아니다. 로컬에 따로 보관할 것.
#    잃으면 GPU 30분을 다시 태워야 한다(VOICE_CLONE.md).
# TTS 는 디스크에서 읽으므로(tts.mjs 의 stylePath) 추적 해제와 무관하게 그대로 돈다.
voice_styles/

# 루틴 실행 로그 (기기별 상이)
state/routine.log

# 겹침 방지 락 (routine.cmd 가 만들고 지운다). 실행 중에만 존재하는 것이라 리포에 안 담는다.
state/routine.lock/

# 파이프라인 단계별 중간 산출물 — 지금은 episodes/<ep>/notes/ 에 남긴다
.staging/

# 옛 구조 잔재 (episodes/ 로 옮기기 전)
build/
